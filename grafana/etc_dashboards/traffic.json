          "editorType": "sql",
          "refId": "A",
          "rawSql": "SELECT bucket, exporter, srcaddr, dstaddr, srcport, dstport, protocol, input, output,\n       sum(total_packets) AS packets, sum(total_bytes) AS bytes\nFROM flows_5minute_mv\nWHERE $__timeFilter(bucket)\n  AND exporter IN (${exporter:singlequote})\n  AND protocol IN (${protocol:csv})\n  AND input IN (${ifacein:csv})\n  AND output IN (${ifaceout:csv})\n  AND ('${srcaddr}' = '' OR srcaddr = '${srcaddr}')\n  AND ('${dstaddr}' = '' OR dstaddr = '${dstaddr}')\n  AND ('${srcport}' = '' OR srcport = toUInt16OrZero('${srcport}'))\n  AND ('${dstport}' = '' OR dstport = toUInt16OrZero('${dstport}'))\nGROUP BY bucket, exporter, srcaddr, dstaddr, srcport, dstport, protocol, input, output\nORDER BY bytes DESC\nLIMIT 1000",
          "format": 1,
          "queryType": "table"
        }
